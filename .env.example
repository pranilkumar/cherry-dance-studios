# 2026 Futuristic Dance Studio - Environment Variables

# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Configuration (Payment System)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key
STRIPE_SECRET_KEY=sk_live_your_secret_key

# OpenAI / AI Configuration (for chatbot and recommendations)
VITE_OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4-turbo

# Groq Configuration (FREE AI Chatbot)
VITE_GROQ_API_KEY=your-groq-api-key
VITE_GROQ_MODEL=mixtral-8x7b-32768

# Firebase Configuration (for real-time notifications)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Web Push Notifications (PWA)
VITE_PUBLIC_VAPID_KEY=your-public-vapid-key
VAPID_PRIVATE_KEY=your-private-vapid-key

# Socket.IO Configuration (Real-time features)
VITE_SOCKET_IO_URL=wss://api.cherrydance.com

# AWS Configuration (for file uploads and storage)
VITE_AWS_REGION=ca-central-1
VITE_AWS_ACCESS_KEY_ID=your-aws-access-key
VITE_AWS_SECRET_ACCESS_KEY=your-aws-secret-key
VITE_AWS_S3_BUCKET=cherry-dance-studio-bucket

# Google Analytics (for tracking)
VITE_GOOGLE_ANALYTICS_ID=G-your-tracking-id

# Environment
VITE_NODE_ENV=production
VITE_API_URL=https://api.cherrydance.com
VITE_APP_URL=https://cherrydance.com

# Email Service Configuration
VITE_EMAILJS_SERVICE_ID=service_your_id
VITE_EMAILJS_TEMPLATE_ID=template_your_id
VITE_EMAILJS_USER_ID=your_user_id

# Crypto Payment Integration (for Bitcoin/Ethereum)
VITE_CRYPTO_API_KEY=your-crypto-payment-key

# Face Recognition API (optional)
VITE_FACE_API_KEY=your-face-recognition-api-key

# QR Code Generation
VITE_QR_CODE_API_KEY=your-qr-code-api-key

# Analytics and BI
VITE_ANALYTICS_API_URL=https://analytics.cherrydance.com
VITE_ANALYTICS_API_KEY=your-analytics-key

