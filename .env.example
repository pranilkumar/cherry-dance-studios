# Cherry Dance Studios — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Supabase ───────────────────────────────────────────────────────────────────
# Project URL and anon key (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin panel ────────────────────────────────────────────────────────────────
# Credentials for the /admin login page
ADMIN_EMAIL=admin@cherrydancestudios.com
ADMIN_PASSWORD=change-me-to-something-strong

# Secret used to sign HMAC-SHA256 admin session tokens.
# Generate with: openssl rand -base64 32
ADMIN_JWT_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Used for payment receipts and overdue fee reminders.
# Get your key at https://resend.com
RESEND_API_KEY=re_your_key

# ── Public site URL ────────────────────────────────────────────────────────────
# Used by sitemap.js and robots.js
NEXT_PUBLIC_SITE_URL=https://cherrydancestudios.com
